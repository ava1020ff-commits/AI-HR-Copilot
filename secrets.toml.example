# Copy to .streamlit/secrets.toml locally, or paste into Cloud Advanced settings.
# Empty key keeps JD Mock and local resume parsing enabled.
LLM_API_KEY = ""
LLM_BASE_URL = "https://api.openai.com/v1"
LLM_MODEL = ""

# Optional, project-relative Linux-compatible paths. Not durable on Cloud.
JD_DATABASE_PATH = "database/recruitment.sqlite3"
# RESUME_DATABASE_PATH defaults to JD_DATABASE_PATH; normally leave unset.
